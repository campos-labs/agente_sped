# Arquivo opcional. As análises locais funcionam sem .env e sem credenciais.
# Roteamento assistido é opt-in; a chave só é exigida ao consultar o provedor.
AI_ROUTING_ENABLED=false
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_TIMEOUT_SECONDS=30

# Sessões privadas da interface local, fora do repositório por padrão.
SPED_RETENTION_HOURS=24
# SPED_SESSION_ROOT=/caminho/privado/sessoes

# Capacidades ainda não implementadas: ativá-las produz erro de configuração.
AI_NARRATIVE_ENABLED=false
EXPLORATORY_SQL_ENABLED=false
